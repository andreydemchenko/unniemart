<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.andrei.unniemart-news</string>
  <key>ProgramArguments</key>
  <array><string>/Users/macbookpro/Documents/Projects/unniemart/automations/run.sh</string><string>daily</string></array>
  <!-- Every day 07:30 laptop time (UTC+7) = 08:30 Philippine time. A missed run happens when the laptop wakes. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardErrorPath</key><string>/Users/macbookpro/Documents/Projects/unniemart/data/logs/launchd-news.err</string>
</dict>
</plist>
